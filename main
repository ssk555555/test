'転記用の関数、Mappingシートで指定されたセル位置に転記するよ

Private Sub Export_Mapping(Company As String)

Dim wsTemplate As Worksheet
Dim wsMapping As Worksheet
Dim ctrl1 As Object, ctrl2 As Object, ctrl3 As Object
Dim toggleCtrl As MSForms.ToggleButton
Dim lastRow As Long
Dim i As Long
Dim ctrl1Name As String, ctrl2Name As String, ctrl3Name As String
Dim Cell1 As String, Cell2 As String, Cell3 As String, Cell4 As String, Cell5 As String, Cell6 As String, Cell7 As String, Cell8 As String
Dim toggleName As String, toggleTrueValue As Variant, toggleFalseValue As Variant
Dim valueToTransfer As Variant, combinedValue As String
Dim transferType As String, toggleValue As Boolean
Dim Prefix As String

'Mappingシートをセットし、読み込む最終行を取得
Set wsMapping = ThisWorkbook.Sheets("Mapping")
lastRow = wsMapping.Cells(wsMapping.Rows.Count, "A").End(xlUp).Row

'Mappingシートをループして転記
For i = 2 To lastRow
    ctrl1Name = wsMapping.Cells(i, 1).Value
    companyName = wsMapping.Cells(i, 2).Value
    Cell1 = wsMapping.Cells(i, 3).Value
    Cell2 = wsMapping.Cells(i, 4).Value
    Cell3 = wsMapping.Cells(i, 5).Value
    Cell4 = wsMapping.Cells(i, 6).Value
    Cell5 = wsMapping.Cells(i, 7).Value
    Cell6 = wsMapping.Cells(i, 8).Value
    Cell7 = wsMapping.Cells(i, 9).Value
    Cell8 = wsMapping.Cells(i, 10).Value
    Cell9 = wsMapping.Cells(i, 11).Value
    Cell10 = wsMapping.Cells(i, 12).Value
    Cell11 = wsMapping.Cells(i, 13).Value
    Cell12 = wsMapping.Cells(i, 14).Value
    ctrl2Name = wsMapping.Cells(i, 15).Value
    ctrl3Name = wsMapping.Cells(i, 16).Value
    toggleName = wsMapping.Cells(i, 17).Value
    toggleTrueValue = wsMapping.Cells(i, 18).Value
    toggleFalseValue = wsMapping.Cells(i, 19).Value
    transferType = wsMapping.Cells(i, 20).Value
    Prefix = wsMapping.Cells(i, 21).Value

'コントロールの開放
Set ctrl1 = Nothing
Set ctrl2 = Nothing
Set ctrl3 = Nothing
Set toggleCtrl = Nothing


'コントロールのチェック
On Error Resume Next

Set ctrl1 = Me.Controls(ctrl1Name)
If ctrl2Name <> "" Then
    Set ctrl2 = Me.Controls(ctrl2Name)
End If
If ctrl3Name <> "" Then
    Set ctrl3 = Me.Controls(ctrl3Name)
End If

If toggleName <> "" Then
    Set toggleCtrl = Me.Controls(toggleName)
End If
On Error GoTo 0

'トグル判定
If Not toggleCtrl Is Nothing Then
    toggleValeu = toggleCtrl.Value
    If toggleValeu = True Then
    
       valueToTransfer = IIf(toggleTrueValue <> "", toggleTrueValue, ctrl1.Value)
    Else
       valueToTransfer = toggleFalseValue
    End If

    
Else
    'トグルがないとき
    valueToTransfer = ctrl1.Value
End If

    
'出力先シートをセット

Set wsTemplate = ThisWorkbook.Sheets("Template_ALL_test")

'カンパニーで転記するか判断
If companyName = Company Or companyName = "AS" Or companyName = "Common" Then

'出力処理
Select Case transferType
    'Case "single"
        '単一セルに転記
    '    If Cell1 <> "" Then wsTemplate.Range(Cell1).Value = valueToTransfer
        
    Case "single"
        '単一の値を転記
        If Cell1 <> "" Then wsTemplate.Range(Cell1).Value = valueToTransfer
        If Cell2 <> "" Then wsTemplate.Range(Cell2).Value = valueToTransfer
        If Cell3 <> "" Then wsTemplate.Range(Cell3).Value = valueToTransfer
        If Cell4 <> "" Then wsTemplate.Range(Cell4).Value = valueToTransfer
        If Cell5 <> "" Then wsTemplate.Range(Cell5).Value = valueToTransfer
        If Cell6 <> "" Then wsTemplate.Range(Cell6).Value = valueToTransfer
        If Cell7 <> "" Then wsTemplate.Range(Cell7).Value = valueToTransfer
        If Cell8 <> "" Then wsTemplate.Range(Cell8).Value = valueToTransfer
        If Cell9 <> "" Then wsTemplate.Range(Cell9).Value = valueToTransfer
        If Cell10 <> "" Then wsTemplate.Range(Cell10).Value = valueToTransfer
        If Cell11 <> "" Then wsTemplate.Range(Cell11).Value = valueToTransfer
        If Cell12 <> "" Then wsTemplate.Range(Cell12).Value = valueToTransfer
    Case "combine"
        '2つの値をくっつける場合、支払限度額と免責額のケース,Prefixもつける
        If Not ctrl2 Is Nothing Then
            If Not (ctrl1.Value = "" Or ctrl1.Value = "付帯無し") Then
            combinedValue = ctrl1.Value & "(免責" & ctrl2.Value & ")"
            Else: combinedValue = "付帯無し"
            End If
        If combinedValue <> "付帯無し" Then
            If Cell1 <> "" Then wsTemplate.Range(Cell1).Value = Prefix & combinedValue
            If Cell2 <> "" Then wsTemplate.Range(Cell2).Value = Prefix & combinedValue
            If Cell3 <> "" Then wsTemplate.Range(Cell3).Value = Prefix & combinedValue
            If Cell4 <> "" Then wsTemplate.Range(Cell4).Value = Prefix & combinedValue
            If Cell5 <> "" Then wsTemplate.Range(Cell5).Value = Prefix & combinedValue
            If Cell6 <> "" Then wsTemplate.Range(Cell6).Value = Prefix & combinedValue
            If Cell7 <> "" Then wsTemplate.Range(Cell7).Value = Prefix & combinedValue
            If Cell8 <> "" Then wsTemplate.Range(Cell8).Value = Prefix & combinedValue
            If Cell9 <> "" Then wsTemplate.Range(Cell9).Value = Prefix & combinedValue
            If Cell10 <> "" Then wsTemplate.Range(Cell10).Value = Prefix & combinedValue
            If Cell11 <> "" Then wsTemplate.Range(Cell11).Value = Prefix & combinedValue
            If Cell12 <> "" Then wsTemplate.Range(Cell12).Value = Prefix & combinedValue
        '付帯無し のときは prefix使わない
        Else
            If Cell1 <> "" Then wsTemplate.Range(Cell1).Value = combinedValue
            If Cell2 <> "" Then wsTemplate.Range(Cell2).Value = combinedValue
            If Cell3 <> "" Then wsTemplate.Range(Cell3).Value = combinedValue
            If Cell4 <> "" Then wsTemplate.Range(Cell4).Value = combinedValue
            If Cell5 <> "" Then wsTemplate.Range(Cell5).Value = combinedValue
            If Cell6 <> "" Then wsTemplate.Range(Cell6).Value = combinedValue
            If Cell7 <> "" Then wsTemplate.Range(Cell7).Value = combinedValue
            If Cell8 <> "" Then wsTemplate.Range(Cell8).Value = combinedValue
            If Cell9 <> "" Then wsTemplate.Range(Cell9).Value = combinedValue
            If Cell10 <> "" Then wsTemplate.Range(Cell10).Value = combinedValue
            If Cell11 <> "" Then wsTemplate.Range(Cell11).Value = combinedValue
            If Cell12 <> "" Then wsTemplate.Range(Cell12).Value = combinedValue
                           
         End If
        End If
    Case "toggle"
        'トグルボタンに沿った固定の内容を転記
        If Cell1 <> "" Then wsTemplate.Range(Cell1).Value = valueToTransfer
        If Cell2 <> "" Then wsTemplate.Range(Cell2).Value = valueToTransfer
        If Cell3 <> "" Then wsTemplate.Range(Cell3).Value = valueToTransfer
        If Cell4 <> "" Then wsTemplate.Range(Cell4).Value = valueToTransfer
        If Cell5 <> "" Then wsTemplate.Range(Cell5).Value = valueToTransfer
        If Cell6 <> "" Then wsTemplate.Range(Cell6).Value = valueToTransfer
        If Cell7 <> "" Then wsTemplate.Range(Cell7).Value = valueToTransfer
        If Cell8 <> "" Then wsTemplate.Range(Cell8).Value = valueToTransfer
        If Cell9 <> "" Then wsTemplate.Range(Cell9).Value = valueToTransfer
        If Cell10 <> "" Then wsTemplate.Range(Cell10).Value = valueToTransfer
        If Cell11 <> "" Then wsTemplate.Range(Cell11).Value = valueToTransfer
        If Cell12 <> "" Then wsTemplate.Range(Cell12).Value = valueToTransfer
        
    Case "prefix"
        'コンボボックスの内容にprefixを付ける場合はこちら。1事故・期間中とか
        '付帯無しの場合は prefixを付けない
      If valueToTransfer = "付帯無し" Then
        If Cell1 <> "" Then wsTemplate.Range(Cell1).Value = valueToTransfer
        If Cell2 <> "" Then wsTemplate.Range(Cell2).Value = valueToTransfer
        If Cell3 <> "" Then wsTemplate.Range(Cell3).Value = valueToTransfer
        If Cell4 <> "" Then wsTemplate.Range(Cell4).Value = valueToTransfer
        If Cell5 <> "" Then wsTemplate.Range(Cell5).Value = valueToTransfer
        If Cell6 <> "" Then wsTemplate.Range(Cell6).Value = valueToTransfer
        If Cell7 <> "" Then wsTemplate.Range(Cell7).Value = valueToTransfer
        If Cell8 <> "" Then wsTemplate.Range(Cell8).Value = valueToTransfer
        If Cell9 <> "" Then wsTemplate.Range(Cell9).Value = valueToTransfer
        If Cell10 <> "" Then wsTemplate.Range(Cell10).Value = valueToTransfer
        If Cell11 <> "" Then wsTemplate.Range(Cell11).Value = valueToTransfer
        If Cell12 <> "" Then wsTemplate.Range(Cell12).Value = valueToTransfer
      Else
        If Cell1 <> "" Then wsTemplate.Range(Cell1).Value = Prefix & valueToTransfer
        If Cell2 <> "" Then wsTemplate.Range(Cell2).Value = Prefix & valueToTransfer
        If Cell3 <> "" Then wsTemplate.Range(Cell3).Value = Prefix & valueToTransfer
        If Cell4 <> "" Then wsTemplate.Range(Cell4).Value = Prefix & valueToTransfer
        If Cell5 <> "" Then wsTemplate.Range(Cell5).Value = Prefix & valueToTransfer
        If Cell6 <> "" Then wsTemplate.Range(Cell6).Value = Prefix & valueToTransfer
        If Cell7 <> "" Then wsTemplate.Range(Cell7).Value = Prefix & valueToTransfer
        If Cell8 <> "" Then wsTemplate.Range(Cell8).Value = Prefix & valueToTransfer
        If Cell9 <> "" Then wsTemplate.Range(Cell9).Value = Prefix & valueToTransfer
        If Cell10 <> "" Then wsTemplate.Range(Cell10).Value = Prefix & valueToTransfer
        If Cell11 <> "" Then wsTemplate.Range(Cell11).Value = Prefix & valueToTransfer
        If Cell12 <> "" Then wsTemplate.Range(Cell12).Value = Prefix & valueToTransfer
      End If
End Select
End If
Next i


End Sub

Private Sub Format_Cell_Value(wsTemplate As Worksheet)

'個別プラン用の【個別】の文字列を削除
'1事故・期間中付帯無しとなってる場合の調整
For Each cell In wsTemplate.UsedRange
         cell.Value = Replace(cell.Value, "【個別】", "")
         cell.Value = Replace(cell.Value, "1事故・期間中付帯無し", "付帯無し")
         cell.Value = Replace(cell.Value, "1事故・期間中金額選択", "金額選択")
      
Next cell

End Sub

'選択されたプラン内容で固定される部分を出力する、出力内容はplanシートで管理

Private Sub Export_Plan(Company As String, planType As String)

'プラン複数選択する予定だったが不要になったのでコメントアウト
'planTypeは単一になったので、collection型である必要は無い

Dim wsPlan As Worksheet
Dim wsTemplate As Worksheet
Dim lastRow As String
Dim i As Long
Dim coverageCell As Range
Dim targetCell As Range
Dim similarCell As Range
Dim recommendCell As Range
Dim coverageToTransfer As Variant
Dim valueToTransfer As Variant
Dim similarToTransfer As Variant
Dim recommendToTransfer As Variant

'シートを読み込み
Set wsPlan = ThisWorkbook.Sheets("Plan")
Set wsTemplate = ThisWorkbook.Sheets("Template_ALL_test")

'planシートの最終行を取得
lastRow = wsPlan.Cells(wsPlan.Rows.Count, "A").End(xlUp).Row

'planシート参照して対応するセルに値を入力,loop処理
For i = 3 To lastRow
    'B列に入力されているセル番号に対応する位置を指定:補償名
    Set coverageCell = wsTemplate.Range(wsPlan.Cells(i, "B").Value)
    'J列に入力されているセル番号に対応する位置を指定：補償内容
    Set targetCell = wsTemplate.Range(wsPlan.Cells(i, "J").Value)
    'R列に入力されているセル番号に対応する位置を指定：類似プラン内容
    Set similarCell = wsTemplate.Range(wsPlan.Cells(i, "R").Value)
    'Z列に入力されているセル番号に対応する位置を指定：おすすめプラン内容
    Set recommendCell = wsTemplate.Range(wsPlan.Cells(i, "Z").Value)
    
    
    '会社とプランによって読み込みセルを分ける
        If Company = "MS" And planType = "ベーシック" Then
            coverageToTransfer = wsPlan.Cells(i, "C").Value
            valueToTransfer = wsPlan.Cells(i, "K").Value
            similarToTransfer = wsPlan.Cells(i, "S").Value
            
        ElseIf Company = "MS" And planType = "ワイド" Then
            coverageToTransfer = wsPlan.Cells(i, "D").Value
            valueToTransfer = wsPlan.Cells(i, "L").Value
            similarToTransfer = wsPlan.Cells(i, "T").Value
            
        ElseIf Company = "SJ" And planType = "エコノミー" Then
            coverageToTransfer = wsPlan.Cells(i, "E").Value
            valueToTransfer = wsPlan.Cells(i, "M").Value
            similarToTransfer = wsPlan.Cells(i, "U").Value

        ElseIf Company = "SJ" And planType = "ワイド" Then
            coverageToTransfer = wsPlan.Cells(i, "F").Value
            valueToTransfer = wsPlan.Cells(i, "N").Value
            similarToTransfer = wsPlan.Cells(i, "V").Value
        
        ElseIf Company = "TN" And planType = "①：施設事業活動のみ" Then
            coverageToTransfer = wsPlan.Cells(i, "G").Value
            valueToTransfer = wsPlan.Cells(i, "O").Value
            similarToTransfer = wsPlan.Cells(i, "W").Value
        
        ElseIf Company = "TN" And planType = "②：生産物完成作業のみ" Then
            coverageToTransfer = wsPlan.Cells(i, "H").Value
            valueToTransfer = wsPlan.Cells(i, "P").Value
            similarToTransfer = wsPlan.Cells(i, "X").Value
        
        ElseIf Company = "TN" And planType = "① + ② セット" Then
            coverageToTransfer = wsPlan.Cells(i, "I").Value
            valueToTransfer = wsPlan.Cells(i, "Q").Value
            similarToTransfer = wsPlan.Cells(i, "Y").Value
        
        End If

    'valueがあれば転記
        If Not IsEmpty(coverageToTransfer) Then
            coverageCell.Value = coverageToTransfer
        End If

    'valueがあれば転記
        If Not IsEmpty(valueToTransfer) Then
            targetCell.Value = valueToTransfer
        End If
    
    'valueがあれば転記
        If Not IsEmpty(similarToTransfer) Then
            similarCell.Value = similarToTransfer
        End If
    
    'おすすめプランについてはセルはZ列、値はAA列を参照。おすすめチェックがTrueなら転記
        If CheckBox_AS_Plan.Value = True Then
            recommendToTransfer = wsPlan.Cells(i, "AA").Value
        End If
        If Not IsEmpty(recommendToTransfer) Then
            recommendCell.Value = recommendToTransfer
        End If
    
    
Next i

End Sub

