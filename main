'ミニの時に費用の金額が変わるのでその分岐

Private Sub Combo_cyber_tn_Change()

If Combo_cyber_tn.Value = "1,000万円" Then
   cyber_expence_value.Caption = "200万円"
   
ElseIf Combo_cyber_tn.Value = "3,000万円" Then
       cyber_expence_value.Caption = "1,000万円"

ElseIf Combo_cyber_tn.Value = "5,000万円" Then
       cyber_expence_value.Caption = "2,000万円"
       
ElseIf Combo_cyber_tn.Value = "1億円" Then
       cyber_expence_value.Caption = "3,000万円"

ElseIf Combo_cyber_tn.Value = "3億円" Then
       cyber_expence_value.Caption = "3,000万円"

'商工会プラン追加
ElseIf Combo_cyber_tn.Value = "50万円" Then
       cyber_expence_value.Caption = "50万円"

Else
       cyber_expence_value.Caption = ""
End If
End Sub

Private Sub reset_Click()
'フォームを一回閉じてリセットさせる
Unload Me

'再度ロード
Load Main
Main.Show vbModeless

End Sub

Private Sub save_Click()

Dim saveAsFile As String
Dim newBook As Workbook
Dim shp As Shape

'保存先とファイル名を取得
With Application.FileDialog(msoFileDialogSaveAs)
    .Title = "保存先を選択してください"
    .InitialFileName = "補償内容簡易比較_XXX.xlsx"
    .FilterIndex = 1
    
    'OKで保存
    If .Show = -1 Then
        saveAsFile = .SelectedItems(1)
    Else
        MsgBox "保存がキャンセルされました", vbInformation
        Exit Sub
    End If
End With

'シートのレイアウトをそのまま新しいブックへコピーしたい
ThisWorkbook.Sheets("Template_ALL_test").Copy
Set newBook = ActiveWorkbook

'シート上の余計なボタンを削除
For Each shp In newBook.Sheets(1).Shapes
    If shp.Type = msoFormControl Then
        shp.Delete
    End If
Next shp

With newBook.Sheets(1).PageSetup
    .PrintArea = "C1:I78"
    .Orientation = xlPortrait
    .Zoom = False
    .FitToPagesWide = 1
    .FitToPagesTall = 1
End With
    
'マクロ不能ブックとして保存
Application.DisplayAlerts = False '警告をキャンセル
newBook.SaveAs fileName:=saveAsFile, FileFormat:=xlOpenXMLWorkbook
Application.DisplayAlerts = True

'新しいブックは閉じる
newBook.Close savechanges:=False

'保存完了後の処理
MsgBox "保存が完了しました" & saveAsFile, vbInformation


End Sub

'工事用物損害の付帯が必要な特約

Private Sub Toggle_const_as_Click()
    
If Toggle_const_as.Value = True Then
    Toggle_movable_as.Visible = True
    Toggle_temp_as.Visible = True
    Toggle_maintenance_as.Visible = True
    Toggle_warranty_as.Visible = True

Else
    Toggle_movable_as.Value = False
    Toggle_temp_as.Value = False
    Toggle_maintenance_as.Value = False
    Toggle_warranty_as.Value = False
    
    Toggle_movable_as.Visible = False
    Toggle_temp_as.Visible = False
    Toggle_maintenance_as.Visible = False
    Toggle_warranty_as.Visible = False
    
    Combo_movable_as.Clear
    Combo_temp_as.Clear
    Combo_maintenance_as.Clear
    Combo_warranty_as.Clear
   
    
End If


End Sub

