Private Sub UserForm_Initialize()

'ユーザーフォームおしゃれ化
Call CustomizeUserForm

'コンボボックスとか読み込み

Dim ws As Worksheet
Dim table As ListObject
'Dim col1 As Range, col2 As Range, col3 As Range, col4 As Range
Dim rng As Range
Dim cell As Range
Dim colIndex As Integer
Dim colData As Collection
Dim ctrl As Control
Dim i As Integer
Dim controlCount As Integer




'コレクションを初期化
Set ComboBoxData = New Collection

'ComboBoxシートのテーブルから必要な情報を取得する

Set ws = ThisWorkbook.Sheets("ComboBOX")
Set table = ws.ListObjects("Basic_Info")

For colIndex = 1 To table.ListColumns.Count
    Set colData = New Collection
    Set rng = table.ListColumns(colIndex).DataBodyRange
    For Each cell In rng
    '空のカラムはスキップする
        If Not IsEmpty(cell.Value) Then
            colData.Add cell.Value
        End If
    Next cell
    ComboBoxData.Add colData, table.ListColumns(colIndex).Name
Next colIndex

'colNoとComboBoxNameの組み合わせを参照するため
Set table = Nothing
Set table = ws.ListObjects("Col_info")


'デフォルト表示のコンボボックスにリストを追加


LoadComboBox Combo_Limit, "col1" '他社基本補償支払限度額
LoadComboBox Combo_Deductible, "col2" '他社基本補償免責金額
LoadComboBox Combo_Limit_AS, "col3" 'ALLSTARs支払限度額
LoadComboBox Combo_Deductible_AS, "col4" 'ALLSTARs免責金額


'プラン情報管理
Set companyPlans = CreateObject("Scripting.dictionary")

companyPlans.Add "MS", Array("ベーシック", "ワイド")
companyPlans.Add "SJ", Array("エコノミー", "ワイド")
companyPlans.Add "TN", Array("①：施設事業活動のみ", "②：生産物完成作業のみ", "① + ② セット")

'コントロール管理
controlCount = 0
For Each ctrl In Me.Controls
    If TypeOf ctrl Is MSForms.ToggleButton Or TypeOf ctrl Is MSForms.combobox Then
        controlCount = controlCount + 1
    End If
Next ctrl

    'コントロール用配列サイズを宣言
ReDim ControlHandler(1 To controlCount)

    '各トグルとコンボボックスにイベントを設定
i = 1
For Each ctrl In Me.Controls
    If TypeOf ctrl Is MSForms.ToggleButton Then
        Set ControlHandler(i) = New clsControlHandler
        Set ControlHandler(i).Toggle = ctrl
        Set ControlHandler(i).MainForm = Me 'フォームのインスタンス化
        
        'Col_infoテーブルからcomboboxと対応するcolNoを取得する
        Dim ComboBoxName As String
        Dim colNo As String
        Dim foundCell As Range
        
        ComboBoxName = ""
        
        'comboboxName列で一致するセルを探す
        Set foundCell = table.ListColumns("ToggleName").DataBodyRange.Find(what:=ctrl.Name, LookIn:=xlValues, lookat:=xlWhole)
        
        If Not foundCell Is Nothing Then
        '一致する場合は対応するColNoを取得
        colNo = table.ListColumns("ColNo").DataBodyRange.Cells(foundCell.Row - table.DataBodyRange.Row + 1, 1).Value
        ComboBoxName = table.ListColumns("ComboBoxName").DataBodyRange.Cells(foundCell.Row - table.DataBodyRange.Row + 1, 1).Value
        
        Dim comboBoxControl As Object
        Set comboBoxControl = Me.Controls(ComboBoxName)
        
        End If
        'コンボボックスとcolnoの設定
        If Not comboBoxControl Is Nothing Then
            Set ControlHandler(i).combobox = comboBoxControl
            ControlHandler(i).ColName = colNo
        End If

        i = i + 1
    
    ElseIf TypeOf ctrl Is MSForms.combobox Then
        Set ControlHandler(i) = New clsControlHandler
        Set ControlHandler(i).combobox = ctrl
        
        i = i + 1

    End If

    
Next ctrl


'マルチページは最初は非表示
MultiPage1.Visible = False


End Sub




Private Sub CustomizeUserForm()
'ユーザーフォームをおしゃれにするよ

With Me
    .BackColor = RGB(225, 235, 245) '薄い系の青
    .Font.Name = "Calibri"
    .Font.Size = 11
End With

Dim ctrl As Control
'フォーム上の各コントロールをオシャレに

For Each ctrl In Me.Controls
    'コマンドボタン
    If TypeOf ctrl Is MSForms.CommandButton Then
        With ctrl
            .BackColor = RGB(100, 149, 237) '青
            .ForeColor = RGB(255, 255, 255) '白
            .Font.Name = "Calibri"
            .Font.Size = 11

        End With
    
    'テキストボックス
    ElseIf TypeOf ctrl Is MSForms.TextBox Then
        With ctrl
            .BackColor = RGB(245, 245, 255) '薄い青
            .ForeColor = RGB(0, 0, 128) '濃い青
            .BorderStyle = fmBorderStyleSingle '枠線
            .Font.Name = "Calibri"
            .Font.Size = 11
        End With

    'トグルボタン
    ElseIf TypeOf ctrl Is MSForms.ToggleButton Then
        With ctrl
            .BackColor = RGB(173, 216, 230) 'ライトブルー
            .ForeColor = RGB(0, 0, 128) '濃い青
            .Font.Name = "Calibri"
            .Font.Size = 9
        End With
        
    'ラベル
    ElseIf TypeOf ctrl Is MSForms.Label Then
        With ctrl
            .BackStyle = fmBackStyleTransparent ' 背景透過
            .ForeColor = RGB(0, 0, 128) '濃い青
            .Font.Name = "Calibri"
            .Font.Size = 11
        
        End With

    'リストボックス
    ElseIf TypeOf ctrl Is MSForms.ListBox Then
        With ctrl
            .BackColor = RGB(245, 245, 255) 'ホワイトブルー
            .ForeColor = RGB(0, 0, 128) '濃い青
            .BorderStyle = fmBorderStyleSingle '枠線
            .Font.Name = "Calibri"
            .Font.Size = 8
        End With
        
    'コンボボックス
    ElseIf TypeOf ctrl Is MSForms.combobox Then
        With ctrl
            .BackColor = RGB(245, 245, 255) 'ホワイトブルー
            .ForeColor = RGB(0, 0, 128) '濃い青
            .BorderStyle = fmBorderStyleSingle '枠線
            .Font.Name = "Calibri"
            .Font.Size = 9
        End With
        
    'チェックボックス
    ElseIf TypeOf ctrl Is MSForms.CheckBox Then
        With ctrl
            .BackStyle = fmBackStyleTransparent ' 背景透過
            .ForeColor = RGB(0, 0, 128) '濃い青
            .Font.Name = "Calibri"
            .Font.Size = 11
        End With
        
      'オプションボタン
    ElseIf TypeOf ctrl Is MSForms.OptionButton Then
        With ctrl
            .BackStyle = fmBackStyleTransparent ' 背景透過
            .ForeColor = RGB(0, 0, 128) '濃い青
            .Font.Name = "Calibri"
            .Font.Size = 11
        End With
        
      'フレーム
    ElseIf TypeOf ctrl Is MSForms.frame Then
        With ctrl
            '.BackColor = RGB(200, 220, 240) 'ちょい青
            .BackColor = RGB(225, 235, 245)
            .ForeColor = RGB(0, 0, 128) '濃い青
            .Font.Name = "Calibri"
            .Font.Size = 11
        End With
        
      'マルチページ
    ElseIf TypeOf ctrl Is MSForms.MultiPage Then
        With ctrl
            '.BackColor = RGB(200, 220, 240) 'ちょい青
            .BackColor = RGB(225, 235, 245)
            .ForeColor = RGB(0, 0, 128) '濃い青
            .Font.Name = "Calibri"
            .Font.Size = 11
        End With
        
    End If
    
Next ctrl


End Sub

'コンボボックスの中身をロードするよ

Public Sub LoadComboBox(cmb As MSForms.combobox, columnName As String)

Dim colData As Collection
Dim item As Variant

'コンボボックスをクリア
cmb.Clear

'対応するカラムのデータを取得
Set colData = ComboBoxData(columnName)

'データをロード
For Each item In colData
    cmb.AddItem item
Next item

End Sub

'リストボックスにプランを表示するよ...TNが簡単だったのでもっとシンプルで良かった

Private Sub PopulatePlans(ByVal Company As String)
    ListBox1.Clear
    
    If companyPlans.exists(Company) Then
        Dim plans As Variant
        plans = companyPlans(Company)

        Dim i As Integer
        For i = LBound(plans) To UBound(plans)
            ListBox1.AddItem plans(i)
        Next i
    End If


    'TNもsingle selectで良くなったため、companyの分岐は無効にしておく
    If Company = "" Then
        ListBox1.MultiSelect = fmMultiSelectMulti
    Else
        ListBox1.MultiSelect = fmMultiSelectSingle
    End If


End Sub


Private Sub OptionButton_TN_Click()

    If OptionButton_TN.Value = True Then
    'プランを表示
        PopulatePlans "TN"
    
    'TNに切り替え
    '   TabStrip1.Value = 0　tabstripじゃなくてmultipageを使うように変更
        MultiPage1.Visible = True
    

    'page名は選択したやつだけ(0=TN,1=MS,2=SJ)
        MultiPage1.Pages(0).Visible = True
        MultiPage1.Pages(1).Visible = False
        MultiPage1.Pages(2).Visible = False
        MultiPage1.Pages(3).Visible = False
        
        MultiPage1.Value = 0
        
    'SJの時のみ受託基本補償分を表示
        Label_basicBailee_sj.Visible = False
        Combo_basicBailee_sj.Visible = False
            
    End If
End Sub


Private Sub OptionButton_MS_Click()

    If OptionButton_MS.Value = True Then
    'プランを表示
        PopulatePlans "MS"
        
    'MSに切り替え
    '   TabStrip1.Value = 1 tabstripじゃなくてmultipageを使うように変更
        MultiPage1.Visible = True
    

    'page名は選択したやつだけ(0=TN,1=MS,2=SJ)
        MultiPage1.Pages(0).Visible = False
        MultiPage1.Pages(1).Visible = True
        MultiPage1.Pages(2).Visible = False
        MultiPage1.Pages(3).Visible = False
        
        MultiPage1.Value = 1
        
    'SJの時のみ受託基本補償分を表示
        Label_basicBailee_sj.Visible = False
        Combo_basicBailee_sj.Visible = False
        
    End If
    
End Sub

Private Sub OptionButton_SJ_Click()

    If OptionButton_SJ.Value = True Then
    'プランを表示
        PopulatePlans "SJ"
    'SJに切り替え
    '   TabStrip1.Value = 2　tabstripじゃなくてmultipageを使うように変更
        MultiPage1.Visible = True
     

    'page名は選択したやつだけ(0=TN,1=MS,2=SJ)
        MultiPage1.Pages(0).Visible = False
        MultiPage1.Pages(1).Visible = False
        MultiPage1.Pages(2).Visible = True
        MultiPage1.Pages(3).Visible = False
        
        MultiPage1.Value = 2
        
    'SJの時のみ受託基本補償分を表示
        Label_basicBailee_sj.Visible = True
        Combo_basicBailee_sj.Visible = True
        
        Combo_basicBailee_sj.Clear
        Combo_basicBailee_sj.AddItem "100万円"
        Combo_basicBailee_sj.AddItem "500万円"
        Combo_basicBailee_sj.AddItem "1,000万円"
        
    End If
  
End Sub

'ASおすすめプランボタンをクリックしたときにマルチページに表示、チェック外したら非表示
