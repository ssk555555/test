   wsTemplate.Range("F17").Value = Combo_basicBailee_sj.Value
   wsTemplate.Range("F18").Value = Combo_basicBailee_sj.Value & "※リース・レンタル契約のみ"
   wsTemplate.Range("F19").Value = Combo_basicBailee_sj.Value & "※リース・レンタル契約のみ"
   wsTemplate.Range("F21").Value = Combo_basicBailee_sj.Value
  
  '財物損壊のない使用不能もここで指定_基本補償の保険金額を引用する必要があるため,ワイドのみ
  If ListBox1.Value = "ワイド" Then
   wsTemplate.Range("F10").Value = "1事故・期間中" & Combo_Limit.Value
   wsTemplate.Range("F29").Value = "1事故・期間中" & Combo_Limit.Value
   wsTemplate.Range("F38").Value = "1事故・期間中" & Combo_Limit.Value
  End If
  
