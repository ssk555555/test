'checkboxのオンオフでフレーム内の情報の表示等切り替える
Private Sub Change_CheckBox(chkBox As MSForms.CheckBox, frame As MSForms.frame)
Dim ctrl As Control
    
    If chkBox.Value = True Then
        'チェックボックスon時は見えるように
        For Each ctrl In frame.Controls
            If TypeOf ctrl Is ToggleButton Then
                'ctrl.Value = False
                ctrl.Visible = True
            ElseIf TypeOf ctrl Is combobox Then
                'ctrl.Clear
                ctrl.Visible = True
            End If
        Next ctrl
        
    ElseIf chkBox.Value = False Then
        'チェックが外れた場合は、フレーム内を全リセットして見えなくさせる
        For Each ctrl In frame.Controls
            If TypeOf ctrl Is ToggleButton Then
                ctrl.Value = False
                ctrl.Visible = False
            ElseIf TypeOf ctrl Is combobox Then
                ctrl.Clear
                ctrl.Visible = False
            End If
        Next ctrl
    End If

End Sub



