    MultiPage1.Value = 3
ElseIf CheckBox_AS_Plan.Value = False Then
    MultiPage1.Pages(3).Visible = False
End If
End Sub

'プランを選択した際に、付帯不可のものについては見えなくさせるよ

'SJ
'サイバー：economyではオプション、wideでは基本補償
'工事物ユニット：economyではメインテナンスのみ、wideで工事用仮設備を追加できる
'休業ユニット：economyではCasualty部分なし、wideのみ食中毒・感染症による休業が追加できる
'製造物自体の損害：economyでは付帯不可

'TN
'①のみの場合：不良完成品、仕事の目的物、納期遅延は付帯不可
'②のみの場合：地盤崩壊付帯不可

Private Sub ListBox1_Click()
'トグルonが反応しないように制御,各トグルはここで個別に関数を呼び出して押す
'isPlanChange = True

If OptionButton_SJ.Value = True Then

    
    If ListBox1.Value = "ワイド" Then

      Toggle_cyber_sj.Value = True
