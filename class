'最大長計算するやつ
Private Function GetMaxItemWidth(combobox As MSForms.combobox) As Single
Dim maxWidth As Single
Dim tempWidth As Single
Dim i As Integer

For i = 0 To combobox.ListCount - 1
    '幅チェック
    tempWidth = TextWidth(combobox.List(i))
    If tempWidth > maxWidth Then
        maxWidth = tempWidth
    End If
Next i

'最終的な幅
GetMaxItemWidth = maxWidth + 20

End Function


'テキストの幅計算
Private Function TextWidth(text As String) As Single
Dim lblTemp As MSForms.Label

Set lblTemp = Main.Controls.Add("Forms.label.1", "lblTemp", True)

lblTemp.Font.Name = combobox.Font.Name
lblTemp.Font.Size = combobox.Font.Size

lblTemp.Caption = text
lblTemp.Visible = False
lblTemp.WordWrap = False
lblTemp.AutoSize = True
TextWidth = lblTemp.Width

Main.Controls.Remove "lblTemp"


End Function
